# PostgreSQL Database Configuration
# Set DATABASE_URL or individual connection parameters:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/library_db

# Or configure individually:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=library_db
# DB_USER=postgres
# DB_PASSWORD=postgres

# LLM Provider Configuration (Optional)
# Leave blank to use built-in offline simulation mode or local Ollama
OLLAMA_HOST=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3.2:latest

# OpenAI API Configuration (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
